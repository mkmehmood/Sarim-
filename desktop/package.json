{
  "name": "gull-zubair-desktop",
  "productName": "Gull and Zubair",
  "version": "1.0.0",
  "description": "Gull & Zubair Naswar Dealers business manager (desktop)",
  "author": "Gull & Zubair",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.gullzubair.sarim.desktop",
    "productName": "Gull and Zubair",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Gull and Zubair"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Gull & Zubair <noreply@example.com>",
      "executableName": "gull-zubair",
      "synopsis": "Gull and Zubair business manager"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "artifactName": "Gull-Zubair-${version}-${os}-${arch}.${ext}"
  }
}
